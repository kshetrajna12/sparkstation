# Sparkstation Supervisor Configuration

# Server settings
HOST=127.0.0.1  # CRITICAL: Localhost only for security
PORT=9001
LOG_LEVEL=info

# Backend configuration
# Docker mode (recommended): Use Docker containers for vLLM/SGLang backends
# Subprocess mode: Use direct Python execution from conda/micromamba environments
USE_DOCKER=true

# Docker images (NVIDIA official images with Blackwell support)
VLLM_DOCKER_IMAGE=nvcr.io/nvidia/vllm:26.01-py3
SGLANG_DOCKER_IMAGE=nvcr.io/nvidia/sglang:26.01-py3

# HuggingFace token for gated models (FLUX.1-dev, etc.)
# Get token from: https://huggingface.co/settings/tokens
# Request FLUX access: https://huggingface.co/black-forest-labs/FLUX.1-dev
HF_TOKEN=hf_XXXXXXXXXXXXXXXX

# Backend Python path (for subprocess mode only - when USE_DOCKER=false)
# See DEPLOYMENT_PRODUCTION.md for conda/micromamba setup
# VLLM_PYTHON_PATH=/opt/backends/vllm/bin/python

# DGX Spark hardware constraints
TOTAL_UNIFIED_MEMORY_GB=128
MEMORY_HARD_LIMIT_GB=110  # 85% of total
MEMORY_SOFT_LIMIT_GB=100  # 78% of total
MAX_RESIDENT_MODELS=5  # Supports 2 chat + 2 embedding models + headroom

# Port allocation for model servers
MODEL_PORT_RANGE_START=8001
MODEL_PORT_RANGE_END=8100

# Auto-suspend settings
AUTO_SUSPEND_ENABLED=true
DEFAULT_IDLE_TIMEOUT_MINUTES=30
AUTO_SUSPEND_CHECK_INTERVAL_SECONDS=60

# Thermal management (DGX Spark)
THERMAL_SUSPEND_THRESHOLD_C=80  # Suspend if above this temp (sustained)
THERMAL_RESUME_THRESHOLD_C=75  # Resume only if below this
THERMAL_SUSTAIN_MS=60000  # Must sustain high temp for 60s
THERMAL_COOLDOWN_MS=120000  # Cooldown period after thermal suspend (120s)

# Health checks
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL_SECONDS=300  # 5 minutes
HEALTH_CHECK_TIMEOUT_SECONDS=5
HEALTH_CHECK_MAX_FAILURES=3  # Mark as FAILED after N consecutive failures

# Model restart policy
AUTO_RESTART_ENABLED=true
AUTO_RESTART_MAX_ATTEMPTS=3
AUTO_RESTART_BACKOFF_MINUTES=1,5,15  # Exponential backoff

# LiteLLM Gateway settings
LITELLM_ADMIN_URL=http://127.0.0.1:8000
LITELLM_MASTER_KEY=sk-sparkstation-admin  # Change in production!
GATEWAY_SYNC_INTERVAL_SECONDS=60

# Database (using SUPERVISOR_DATABASE_URL to avoid conflict with LiteLLM's auto-detection)
SUPERVISOR_DATABASE_URL=sqlite+aiosqlite:///./data/sparkstation.db

# Security (optional)
# API_KEY=your-secret-key-here

# Logging
LOG_TO_FILE=true
LOG_FILE_PATH=./data/sparkstation.log
LOG_MAX_BYTES=10485760  # 10 MB
LOG_BACKUP_COUNT=5

# Startup profile (load named profile instead of default autoload models)
# Available profiles are defined in models.yaml under "profiles:"
# STARTUP_PROFILE=openclaw

# Optional auto-sleep (unload all if system idle > 1 hour)
AUTO_SLEEP_ENABLED=false
AUTO_SLEEP_IDLE_MINUTES=60
