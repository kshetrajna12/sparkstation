# Template: replace USER and /home/USER with your deploy user/paths.
[Unit]
Description=Sparkstation Daily Maintenance
After=network.target

[Service]
Type=oneshot
User=USER
WorkingDirectory=/home/USER/src/github.com/sparkstation
ExecStart=/home/USER/src/github.com/sparkstation/.venv/bin/python scripts/maintenance.py

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sparkstation-maintenance

[Install]
WantedBy=multi-user.target
