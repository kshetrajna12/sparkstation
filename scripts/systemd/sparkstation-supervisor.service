# Template: replace USER and /home/USER with your deploy user/paths.
[Unit]
Description=Sparkstation Supervisor - LLM Model Lifecycle Management
After=network.target

[Service]
Type=simple
User=USER
Group=USER
WorkingDirectory=/home/USER/src/github.com/sparkstation
Environment="PATH=/home/USER/src/github.com/sparkstation/.venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/home/USER/src/github.com/sparkstation/.env

ExecStart=/home/USER/src/github.com/sparkstation/.venv/bin/uvicorn supervisor.main:app --host 127.0.0.1 --port 9001

# Restart policy
Restart=on-failure
RestartSec=5s
StartLimitInterval=200
StartLimitBurst=3

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sparkstation-supervisor

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/USER/src/github.com/sparkstation/data

[Install]
WantedBy=multi-user.target
