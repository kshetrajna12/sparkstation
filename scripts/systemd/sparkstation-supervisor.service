[Unit]
Description=Sparkstation Supervisor - LLM Model Lifecycle Management
After=network.target

[Service]
Type=simple
User=kshetrajna
Group=kshetrajna
WorkingDirectory=/home/kshetrajna/src/github.com/sparkstation
Environment="PATH=/home/kshetrajna/src/github.com/sparkstation/.venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/home/kshetrajna/src/github.com/sparkstation/.env

ExecStart=/home/kshetrajna/src/github.com/sparkstation/.venv/bin/uvicorn supervisor.main:app --host 127.0.0.1 --port 9001

# Restart policy
Restart=on-failure
RestartSec=5s
StartLimitInterval=200
StartLimitBurst=3

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sparkstation-supervisor

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/kshetrajna/src/github.com/sparkstation/data

[Install]
WantedBy=multi-user.target
