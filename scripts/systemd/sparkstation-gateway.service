# Template: replace USER and /home/USER with your deploy user/paths.
[Unit]
Description=Sparkstation Gateway - LiteLLM OpenAI-compatible API
After=network.target sparkstation-supervisor.service
Requires=sparkstation-supervisor.service

[Service]
Type=simple
User=USER
Group=USER
WorkingDirectory=/home/USER/src/github.com/sparkstation
Environment="PATH=/home/USER/src/github.com/sparkstation/.venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/home/USER/src/github.com/sparkstation/.env

ExecStart=/home/USER/src/github.com/sparkstation/.venv/bin/litellm --config gateway/litellm.yaml --host 127.0.0.1 --port 8000 --detailed_debug

# Restart policy
Restart=on-failure
RestartSec=5s
StartLimitInterval=200
StartLimitBurst=3

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sparkstation-gateway

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/USER/src/github.com/sparkstation/data
ReadWritePaths=/home/USER/src/github.com/sparkstation/gateway

[Install]
WantedBy=multi-user.target
